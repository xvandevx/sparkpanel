# Секреты прода. Скопировать в .env на сервере и заполнить: cp .env.example .env
# Всё остальное (хосты, порты, пути) — в docker-compose.yml.

# --- Postgres (читают и контейнер postgres, и backend) ---
POSTGRES_USER=aipanel
POSTGRES_PASSWORD=
POSTGRES_DB=aipanel

# --- MinIO (S3-хранилище медиатеки) ---
# Читает контейнер minio; эти же значения compose подставляет бэкенду
# в S3_ACCESS_KEY / S3_SECRET_KEY (см. docker-compose.yml) — задавать их отдельно не нужно.
# Пароль: openssl rand -hex 24. Минимум 8 символов, иначе minio не стартует.
# Остальные S3_* (endpoint, регион, бакет, префикс ссылок) секретами не являются
# и живут в docker-compose.yml, у сервиса backend.
MINIO_ROOT_USER=aipanel
MINIO_ROOT_PASSWORD=

# --- Backend ---
# Секрет подписи JWT. Сгенерировать: openssl rand -hex 32
PRIVATE_KEY=

# Срок жизни JWT
JWT_EXPIRES_IN=7d

# Администратор через env НЕ задаётся: после первого деплоя откройте https://<домен>/admin —
# панель предложит создать root-пользователя. Эндпоинт первичной настройки закрывается
# сразу после создания (409), так что сделайте это до того, как адрес станет публичным.

# Google OAuth пока не подключён (вход по email/паролю). Понадобится — раскомментировать
# и завести Redirect URI https://<домен>/api/auth/google/callback в Google Cloud Console.
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#GOOGLE_CALL_BACK=https://ai-panel.app/api/auth/google/callback
