		"start": "next start",
		"lint": "next lint",
		"generate-api": "export PATH=\"/opt/homebrew/opt/openjdk@11/bin:$PATH\" && npx --yes @openapitools/openapi-generator-cli@2.15.3 generate -i http://localhost:3402/api/docs-json -g typescript-axios -o ./src/generated/api --additional-properties=withSeparateModelsAndApi=true,enumPropertyNaming=PascalCase,stringEnums=true,supportsES6=true,typescriptThreePlus=true,apiPackage=apis,modelPackage=models",
		"generate-api:clean": "rm -rf src/generated && npm run generate-api"
	},
