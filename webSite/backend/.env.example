# Локальный dev-конфиг бэкенда. Скопировать: cp .env.example .env
# .env в git не коммитим — только этот пример.

# Postgres из webSite/docker-compose.yml (наружу 3403, внутри контейнера 5432)
POSTGRES_HOST=localhost
POSTGRES_PORT=3403
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
# Или одной строкой — тогда POSTGRES_* выше не читаются. TLS: ?sslmode=require
#DATABASE_URL=postgres://postgres:postgres@localhost:3403/postgres

# Внешний адрес панели: из него внешнее API собирает полные адреса файлов
# и `servers` спецификации. Не задан — адрес берётся из запроса (Host, X-Forwarded-Proto)
#PUBLIC_URL=http://localhost:3400

# Порт dev-сервера NestJS. nginx (:3400) проксирует /api сюда.
PORT=3402

# Подпись JWT. Для прода сгенерировать: openssl rand -hex 32
PRIVATE_KEY=dev-secret-change-me

# Google OAuth (пока не подключён — вход по email/паролю).
# Redirect URI должен посимвольно совпадать со значением в Google Cloud Console.
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#GOOGLE_CALL_BACK=http://localhost:3400/api/auth/google/callback

# Срок жизни JWT
JWT_EXPIRES_IN=7d

# Локальный вход без пароля: на экране входа кнопка «Войти без пароля (dev)» входит
# под главным администратором (POST /api/auth/dev-login). Только для локальной
# разработки — при NODE_ENV=production не работает даже с флагом; в prod/.env его нет.
DEV_LOGIN=true

# Главный администратор (root) НЕ задаётся через env: пока его нет, страница /admin
# показывает экран первичной настройки и заводит его через POST /api/auth/setup.
# Как только root создан, этот эндпоинт закрывается (409).

# --- Встроенное хранилище файлов медиатеки ---
# Папка на диске: файл лежит по своему ключу (00/00/78/otchet.pdf), отдаёт его
# сам бэкенд по /uploads/<ключ>. По умолчанию — uploads/ рядом с бэкендом
# (в git не попадает), в образе headless — том /data/uploads.
# S3 подключают как внешнее хранилище в «Настройках → Хранилища».
# UPLOADS_DIR=uploads
