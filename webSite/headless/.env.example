# Секреты для docker-compose.yml. Скопировать: cp .env.example .env
# и заменить значения: каждое — `openssl rand -hex 32`.

# Пароль базы. Он попадает в DATABASE_URL, поэтому без символов вроде @ : / ? #
# (hex из openssl такой и есть)
DB_PASSWORD=change-me

# Подпись входа в панель (JWT). Сменили — все выйдут из панели
PRIVATE_KEY=change-me

# Порт панели на хосте
PORT=3000

# Версия образа: 1.4.0 — ровно она, 1 — свежая 1.x, по умолчанию latest
#SPARKPANEL_VERSION=1

# Внешний адрес панели, как его видят сайт и ассистенты. Не задан — адрес
# берётся из запроса (Host и X-Forwarded-Proto от прокси)
#PUBLIC_URL=https://cms.example.com
